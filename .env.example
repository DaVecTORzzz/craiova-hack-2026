# Copiază fișierul în .env și completează valorile. .env nu se urcă niciodată în git.

# Sursa video: index de webcam (0), URL RTSP sau cale spre un .mp4 (rulat în buclă)
VIDEO_SOURCE=0

# true = backend-ul emite evenimente false, fără model și fără cameră
USE_MOCK=true

# Backend
DATABASE_URL=sqlite:///./safesight.db
SNAPSHOT_DIR=./snapshots
SNAPSHOT_BASE_URL=
RETENTION_DAYS=7
EDGE_TOKEN=dev-edge-token

# Escaladare implicită; fiecare zonă poate suprascrie prin escalate_after_s
DEFAULT_ESCALATE_AFTER_S=30

APP_BASE_URL=http://localhost:5173
MOCK_INTERVAL_S=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PPE_OBSERVATIONS_PER_SHIFT=200
SEED_DEMO_EVENTS=false

# Raport (Groq, mod JSON)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=

# Notificări: Slack incoming webhook, text + link, fără imagini și fără butoane
# Fără el, alertele sunt simulate în log, iar `notified_at` rămâne null (KPI-ul
# „detecție -> alertă" arată „—"). Coada reîncearcă 8 ori, apoi lasă un rând `failed`.
SLACK_WEBHOOK_URL=

# Coada de notificări (secunde intre verificari, backoff, incercari)
OUTBOX_INTERVAL_S=0.25
OUTBOX_BACKOFF_S=1,2,4,8,15,30,60
OUTBOX_MAX_ATTEMPTS=8

# Watchdog de camera: dupa cate secunde fara heartbeat camera e declarata offline.
# 0 = oprit. Edge-urile din demo fac deja poll la /edge/zones, deci heartbeat-ul exista.
CAMERA_OFFLINE_AFTER_S=90
WATCHDOG_INTERVAL_S=10

# Cat timp se refoloseste sumarul turei cat timp cifrele nu se schimba
SUMMARY_TTL_S=900

# Frontend: URL-ul absolut al API-ului, folosit de Vite la build/dev
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
# CORS_ORIGINS de mai sus e citit de backend; adaugă acolo originea frontend-ului,
# nu aici. Valorile 127.0.0.1 sunt doar pentru dev/test, nu pentru producție.
