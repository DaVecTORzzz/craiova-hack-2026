# Copiază fișierul în .env și completează valorile. .env nu se urcă niciodată în git.

# Sursa video: index de webcam (0), URL RTSP sau cale spre un .mp4 (rulat în buclă)
VIDEO_SOURCE=0

# true = backend-ul emite evenimente false, fără model și fără cameră
USE_MOCK=true

# Backend
DATABASE_URL=sqlite:///./safesight.db

# Login (demo): utilizatori username:rol și o parolă comună
JWT_SECRET=
DEMO_USERS=operator:operator,supervisor:supervisor,admin:admin
DEMO_PASSWORD=
SNAPSHOT_DIR=./snapshots
SNAPSHOT_BASE_URL=
RETENTION_DAYS=7
EDGE_TOKEN=dev-edge-token

# Escaladare implicită; fiecare zonă poate suprascrie prin escalate_after_s
DEFAULT_ESCALATE_AFTER_S=30

# Raport (Groq, mod JSON)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# Notificări: Slack incoming webhook, text + link, fără imagini și fără butoane
SLACK_WEBHOOK_URL=

# Frontend (gol = aceeași adresă de pe care e servit)
VITE_API_URL=
