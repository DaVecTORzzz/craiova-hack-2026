# Copiază fișierul în .env și completează valorile. .env nu se urcă niciodată în git.

# Sursa video: index de webcam (0), URL RTSP sau cale spre un .mp4 (rulat în buclă)
VIDEO_SOURCE=0

# true = backend-ul emite evenimente false, fără model și fără cameră
USE_MOCK=true

# Backend
DATABASE_URL=sqlite:///./safetarmac.db
SNAPSHOT_DIR=./snapshots
RETENTION_DAYS=7

# Automatizări
ESCALATE_AFTER_S=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# Notificări (Slack)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Frontend (gol = aceeași adresă de pe care e servit)
VITE_API_URL=
